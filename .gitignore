# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
SpartaMetaverse-KGT/[Ll]ibrary/
SpartaMetaverse-KGT/[Tt]emp/
SpartaMetaverse-KGT/[Oo]bj/
SpartaMetaverse-KGT/[Bb]uild/
SpartaMetaverse-KGT/[Bb]uilds/
SpartaMetaverse-KGT/[Ll]ogs/
SpartaMetaverse-KGT/[Uu]ser[Ss]ettings/



# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
SpartaMetaverse-KGT/[Mm]emoryCaptures/

# Recordings can get excessive in size
SpartaMetaverse-KGT/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
SpartaMetaverse-KGT/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
SpartaMetaverse-KGT/.vs
SpartaMetaverse-KGT/*/.vs
SpartaMetaverse-KGT/*/*/.vs

# Crashlytics generated file
SpartaMetaverse-KGT/crashlytics-build.properties

# Packed Addressables
SpartaMetaverse-KGTh/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
SpartaMetaverse-KGT/[Aa]ssets/[Ss]treamingAssets/aa.meta
SpartaMetaverse-KGT/[Aa]ssets/[Ss]treamingAssets/aa/*
SpartaMetaverse-KGT//Client
